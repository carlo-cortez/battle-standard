# Safe to expose in the browser; Supabase protects rows with Auth + RLS.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Server-only AI providers. Groq is primary; Gemini is the automatic fallback.
# One key is enough to run recommendations, but both are recommended on free tiers.
# Never prefix either key with VITE_.
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-3.5-flash
GROQ_API_KEY=your-groq-api-key
GROQ_MODEL=openai/gpt-oss-120b
# Local manual smoke test only. Set true for one run, verify the Gemini fallback badge, then restore false.
AI_FORCE_GEMINI_FALLBACK=false

# Server uses these to validate the signed-in user before calling an AI provider.
# They may be the same values as the two VITE_ variables above.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-or-publishable-key

PORT=8787
