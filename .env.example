# Safe to expose in the browser; Supabase protects rows with Auth + RLS.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Server-only AI providers. Groq is primary; Gemini is the automatic fallback.
# One key is enough to run recommendations, but both are recommended on free tiers.
# Never prefix either key with VITE_.
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-3.5-flash
GROQ_API_KEY=your-groq-api-key
GROQ_MODEL=openai/gpt-oss-120b
# Local manual smoke test only. Set true for one run, verify the Gemini fallback badge, then restore false.
AI_FORCE_GEMINI_FALLBACK=false

# Per signed-in user. These limits apply across team previews, live recommendations, and follow-ups.
# The MVP limiter is held in server memory and resets whenever the server restarts.
AI_REQUESTS_PER_MINUTE=6
AI_REQUESTS_PER_HOUR=30
AI_TIMEOUT_MS=6000

# Optional hard ceiling on total AI requests per rolling 24h across ALL users.
# 0 disables it. Held in server memory (resets on restart) unless the persistent
# quota below is enabled, in which case it is also enforced in Supabase.
AI_REQUESTS_PER_DAY_GLOBAL=0

# Optional sign-in allowlist for AI features: comma-separated Google account emails.
# Leave empty to allow any signed-in user. Others receive 403.
ALLOWED_EMAILS=

# Durable, shared quota stored in Supabase. Apply
# supabase/migrations/202610120001_ai_usage_quota.sql first, then set true.
# If the function is missing or Supabase is unreachable, the server falls back
# to the in-memory limiter.
AI_PERSISTENT_QUOTA=false

# Server uses these to validate the signed-in user before calling an AI provider.
# They may be the same values as the two VITE_ variables above.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-or-publishable-key

PORT=8787
