# Safe to expose in the browser; Supabase protects rows with Auth + RLS.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Server-only. Create this in Google AI Studio. Never prefix it with VITE_.
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-3.5-flash

# Server uses these to validate the signed-in user before calling OpenAI.
# They may be the same values as the two VITE_ variables above.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-or-publishable-key

PORT=8787
